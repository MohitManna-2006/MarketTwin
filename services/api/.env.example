# Historical data is disabled unless explicitly selected by an import request.
MARKETTWIN_HISTORICAL_MAX_PAGES=20

# Backend only. Never expose these values through Vite/React variables.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Optional writable workspace override.
# MARKETTWIN_WORKSPACE=/absolute/path/to/local/markettwin-workspace
