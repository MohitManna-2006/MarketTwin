# Historical data is disabled unless explicitly selected by an import request.
MARKETTWIN_HISTORICAL_MAX_PAGES=20

# Backend only. Never expose these values through Vite/React variables.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Live market data (Phase 4B). The feed starts only when asked unless autostart is on;
# most Alpaca plans allow one stream connection per account.
# MARKETTWIN_LIVE_FEED=iex            # iex, test, or mock
# MARKETTWIN_LIVE_AUTOSTART=false
# MARKETTWIN_LIVE_SYMBOLS=AAPL,NVDA,MSFT,SPY
# MARKETTWIN_LIVE_MAX_SYMBOLS=30
# MARKETTWIN_LIVE_MOCK_URL=ws://127.0.0.1:8765/v2/mock
# Required for live controls from another machine; loopback requests need no token.
# MARKETTWIN_LIVE_CONTROL_TOKEN=

# Optional writable workspace override.
# MARKETTWIN_WORKSPACE=/absolute/path/to/local/markettwin-workspace
