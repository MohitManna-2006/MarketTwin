BasedOnStyle: LLVM
Standard: c++20
ColumnLimit: 100
IndentWidth: 2
AccessModifierOffset: -2
PointerAlignment: Left
DerivePointerAlignment: false
SortIncludes: true
IncludeBlocks: Regroup
AllowShortFunctionsOnASingleLine: Inline
BreakBeforeBraces: Attach
InsertBraces: true
IncludeCategories:
  - Regex: '^"markettwin/'
    Priority: 1
  - Regex: '^"'
    Priority: 2
  - Regex: '^<'
    Priority: 3
