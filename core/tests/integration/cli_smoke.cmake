# OUTPUT is a CTest-owned directory under the build tree, never user run data.
file(REMOVE_RECURSE "${OUTPUT}")
file(MAKE_DIRECTORY "${OUTPUT}")
foreach(run IN ITEMS first second)
  execute_process(COMMAND "${CLI}" run --config "${SOURCE}/configs/phase1b_demo.json"
    --output "${OUTPUT}/${run}" RESULT_VARIABLE result OUTPUT_VARIABLE summary ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "CLI run failed: ${error}")
  endif()
  execute_process(COMMAND "${CLI}" replay --input "${OUTPUT}/${run}"
    RESULT_VARIABLE result OUTPUT_VARIABLE replay ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "CLI replay failed: ${replay} ${error}")
  endif()
  string(JSON verified GET "${replay}" verified)
  if(NOT verified)
    message(FATAL_ERROR "Replay did not verify: ${replay}")
  endif()
endforeach()
foreach(artifact IN ITEMS config.json commands.jsonl trace.jsonl manifest.json)
  file(SHA256 "${OUTPUT}/first/${artifact}" first_hash)
  file(SHA256 "${OUTPUT}/second/${artifact}" second_hash)
  if(NOT first_hash STREQUAL second_hash)
    message(FATAL_ERROR "Repeated CLI artifact differs: ${artifact}")
  endif()
endforeach()
execute_process(COMMAND "${CLI}" run --config "${SOURCE}/configs/phase1b_demo.json"
  --output "${OUTPUT}/first" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "CLI overwrote an existing run")
endif()
file(APPEND "${OUTPUT}/first/trace.jsonl" "{}\n")
execute_process(COMMAND "${CLI}" replay --input "${OUTPUT}/first"
  RESULT_VARIABLE result OUTPUT_VARIABLE replay)
if(result EQUAL 0)
  message(FATAL_ERROR "CLI accepted extra trace data")
endif()
