# Phase 2B exit path through the real CLI: run a small paired maker comparison twice,
# require identical deterministic results, replay one of its runs, and refuse to overwrite.
# OUTPUT is a CTest-owned build directory.
file(REMOVE_RECURSE "${OUTPUT}")
file(MAKE_DIRECTORY "${OUTPUT}")
set(config "${SOURCE}/configs/experiments/maker_comparison_smoke.json")
foreach(run IN ITEMS first second)
  execute_process(COMMAND "${CLI}" experiment --config "${config}" --output "${OUTPUT}/${run}"
    RESULT_VARIABLE result OUTPUT_VARIABLE report ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "CLI experiment failed: ${error}")
  endif()
  if(NOT report MATCHES "4 seeds x 2 variants = 8 runs" OR NOT report MATCHES "subject.total_pnl")
    message(FATAL_ERROR "Experiment report is missing its design or comparison: ${report}")
  endif()
  file(READ "${OUTPUT}/${run}/experiment.json" document)
  string(JSON digest_${run} GET "${document}" results_digest)
  string(JSON pairs GET "${document}" results comparison pairs_completed)
  if(NOT pairs EQUAL 4)
    message(FATAL_ERROR "Expected four completed pairs, found ${pairs}")
  endif()
endforeach()
if(NOT digest_first STREQUAL digest_second)
  message(FATAL_ERROR "Repeated experiment produced different results")
endif()
file(SHA256 "${OUTPUT}/first/runs.jsonl" first_hash)
file(SHA256 "${OUTPUT}/second/runs.jsonl" second_hash)
if(NOT first_hash STREQUAL second_hash)
  message(FATAL_ERROR "Repeated experiment produced different per-run metrics")
endif()
execute_process(COMMAND "${CLI}" replay --input "${OUTPUT}/first/runs/inventory_maker/seed-3"
  RESULT_VARIABLE result OUTPUT_VARIABLE replay ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Replay of an experiment run failed: ${replay} ${error}")
endif()
execute_process(COMMAND "${CLI}" experiment --config "${config}" --output "${OUTPUT}/first"
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "CLI overwrote a finished experiment")
endif()
